package-as: Flightsim

enable-nolib-creation: no

ignore:
  - README.md
  - CONTRIBUTING.md
  - AGENTS.md
  - SPEC.md
  - Tests
  - docs
  - .luacheckrc
  - .stylua.toml
  - .busted
  - .coverage
  - .cursor
  - .cursorignore
  - .git
  - .github
  - .gitignore
  - .vscode
  - "*.bat"
  - Libs/libs.json
  - assets/images

# No external libraries - standalone addon

# Manual changelog (CurseForge will also pull from git tags)
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
